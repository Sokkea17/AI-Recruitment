# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
HR_TELEGRAM_CHAT_ID=your_hr_telegram_chat_or_group_id

# Database
DATABASE_URL=sqlite+aiosqlite:///./recruitment.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/recruitment_db

# File Storage
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=15

# Security & Authentication
SECRET_KEY=super_secret_session_key_replace_in_production_min_32_chars
HR_DEFAULT_USERNAME=admin
HR_DEFAULT_PASSWORD=admin123
SESSION_EXPIRE_HOURS=24

# AI Configuration (Optional)
AI_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true
